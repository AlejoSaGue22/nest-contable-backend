# ========== BASE DE DATOS (PostgreSQL) ==========
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=finance_tejo

# ========== JWT ==========
JWT_SECRET=<generar-clave-aleatoria-de-32-caracteres>

# ========== SEGURIDAD ==========
CORS_ORIGINS=http://localhost:4200,https://tudominio.com
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ========== FACTUS (DIAN) ==========

# Ambiente: sandbox | production
FACTUS_ENVIRONMENT=sandbox

# Credenciales OAuth2 (obtener del panel de Factus)
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=

# Información de la empresa
FACTUS_NIT=
FACTUS_DV=
FACTUS_RAZON_SOCIAL=

# Establecimiento / Sucursal
FACTUS_ESTABLISHMENT_NAME=
FACTUS_ESTABLISHMENT_ADDRESS=
FACTUS_ESTABLISHMENT_PHONE=
FACTUS_ESTABLISHMENT_EMAIL=
FACTUS_ESTABLISHMENT_MUNICIPALITY_ID=

# Rangos de numeración DIAN (obtener de Factus)
FACTUS_NUMBERING_RANGE_ID=
FACTUS_NC_NUMBERING_RANGE_ID=
FACTUS_ND_NUMBERING_RANGE_ID=
